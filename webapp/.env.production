# Production environment - customize which features to include
# Set to 'false' to completely exclude routes and their code from the bundle

VITE_ENABLE_INGEST=false
VITE_ENABLE_USER_MANAGEMENT=false
VITE_ENABLE_CATEGORIES=true
VITE_ENABLE_CATEGORY_RULES=true
VITE_ENABLE_NAMING_RULES=true
VITE_ENABLE_STATEMENTS=false
