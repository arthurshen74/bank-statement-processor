# Every port and secret the stack uses lives in this one file.
# Copy to .env and fill in the values marked <...>.
#
#   cp .env.example .env
#
# docker-compose.yml reads this automatically. Changing a port here is enough:
# the compose port mappings, the C# CORS policy, the Flask bind port and the
# webapp's generated public/config.json are all derived from these values.

# ---- Ports (host and container use the same number) ----
WEBAPP_PORT=5173
PYTHON_PORT=5001
BACKEND_PORT=5201
MONGO_PORT=27017

# ---- MongoDB ----
# 'mongodb' is the compose service name, resolved on the app-network. Not
# localhost: inside a container that would be the container itself.
MONGO_URI=mongodb://mongodb:27017
# Must match the database the data actually lives in. The Python service
# defaults to 'bankStatementProcessor' when unset, which is a different
# database, and the symptom is a backend showing zero statements with no error.
MONGO_DATABASE=bankstatements

# ---- JWT ----
# Paths as seen inside the backend container, where ./backend is mounted at /src.
# Generate the keypair once on the host:
#   openssl genrsa -out backend/jwt-private-key.pem 2048
#   openssl rsa -in backend/jwt-private-key.pem -pubout -out backend/jwt-public-key.pem
JWT_PRIVATE_KEY_PATH=/src/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=/src/jwt-public-key.pem
JWT_ISSUER=BankStatementProcessor
JWT_AUDIENCE=BankStatementProcessorApp

# ---- LLM ----
# Optional. Powers only the "auto-generate" button that suggests a regex for a
# category or naming rule. Extraction and categorization are entirely
# deterministic and unaffected if this is left unset.
#
# Any server speaking the OpenAI Responses API works. For LM Studio, enable
# "Serve on Local Network" in its Developer tab and use the machine's LAN IP —
# localhost inside a container is the container, not your Mac.
#
#   OpenAI:    https://api.openai.com/v1  +  gpt-4.1-2025-04-14
#   LM Studio: http://<lan-ip>:3000/v1    +  qwen/qwen3.6-35b-a3b
LLM_BASE_URL=http://<lan-ip>:3000/v1
LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_API_KEY=<api key>
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1000
# A large local model on consumer hardware can exceed the 100s HttpClient
# default on a cold load.
LLM_TIMEOUT_SECONDS=120

# ---- Maintenance ----
# python/static is a staging area for page images on their way into GridFS.
# Sweep anything left behind by a failed run when the Python service starts.
PURGE_STATIC_ON_STARTUP=true
